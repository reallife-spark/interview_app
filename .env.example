# Copy to .env for local development. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_TIMEOUT_SECONDS=60

# The UI defaults to OpenRouter. Uncomment only for the offline developer demo.
# PROVIDER=demo

# Local developer mode. The tunnel is created by scripts/model-tunnel.sh.
LOCAL_BASE_URL=http://127.0.0.1:21464/v1
LOCAL_API_KEY=
LOCAL_MODEL=
# agx64/local: omit the 1200-token cap so thinking models can emit visible
# content. Set false to restore the MAX_OUTPUT_TOKENS cap on the local path.
LOCAL_UNCAPPED_OUTPUT=true
# Client timeout for local completions; keep above the nginx read timeout.
LOCAL_TIMEOUT_SECONDS=330

# Safety and cost limits.
ENABLE_LEXICAL_RAG=false
MAX_CALLS=20
MAX_OUTPUT_TOKENS=1200
MAX_INPUT_CHARS=8000
SESSION_COST_CAP_USD=0.50
QUESTION_MEMORY_MAX_ITEMS=500
QUESTION_MEMORY_DUPLICATE_DISTANCE=0.15
